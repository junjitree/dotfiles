#!/usr/bin/env bash
# vi: ft=bash
#
# Keybinding cheatsheet. Hyprland rows are the running binds from
# `hyprctl binds`. tmxr rows are the binds in tmxr's prefix and root key tables
# and in the copy-mode table mode-keys selects: tmxr's built-in defaults with
# ~/.config/tmxr/config.toml layered over them, read on a fresh server (so an
# edit shows before tmxr is reloaded). Rows are tagged "Hyprland", "tmxr" or
# "tmxr copy-mode". Descriptions are hand-written: `description` in
# hyprland.lua, where a bind without one reads "(no description)", and each
# tmxr bind's `note`, where `list-keys -N` leaves out a bind without one. A
# config error or a failed listing shows as a row of its own.
# Picking a row does nothing; type to filter, e.g. "tmxr".

set -o pipefail

pkill pikr && exit 0

# A second press while the list is still being built exits here instead of
# opening a second cheatsheet next to the first.
exec 9>"${XDG_RUNTIME_DIR:?}/menu-keys.lock"
flock -n 9 || exit 0

hypr_binds() {
    local rows
    # Captured first, so a jq error part-way through can't leave half the rows.
    rows=$(hyprctl binds -j | jq -r '
        # Bit values from HL_MODIFIER_* in Hyprland src/devices/IKeyboard.hpp,
        # listed in the order the binds are written in hyprland.lua.
        def mods: . as $m
            | [[64, "SUPER"], [4, "CTRL"], [8, "ALT"], [1, "SHIFT"],
               [2, "CAPS"], [16, "MOD2"], [32, "MOD3"], [128, "MOD5"]]
            | map(select(($m / .[0] | floor) % 2 == 1) | .[1]);
        def keyname: {
            "slash": "/", "period": ".", "comma": ",", "semicolon": ";",
            "mouse:272": "LMB drag", "mouse:273": "RMB drag"
        }[.] // .;
        .[]
        | ["Hyprland",
           ((if .submap == "" then "" else "[\(.submap)] " end)
            + ((.modmask | mods) + [.key | keyname] | join(" + "))),
           (if .has_description then .description else "(no description)" end)]
        | @tsv
    ') || rows=$'Hyprland\t-\tCould not read binds from hyprctl'
    printf '%s\n' "$rows"
}

# Prints any error from loading the config, the mode-keys line ("mode-keys
# vi"), then each table's binds after a "table <name>" line, on a throwaway
# server, so it works with no tmxr running. The config is loaded with
# source-file rather than -f: tmxr skips a config with an error silently at
# startup, but reports it to a source-file client. A failed source-file ends its
# command chain and leaves the server on the defaults, so it gets a call of its
# own and the listing still runs. The server is killed first (one left behind
# would still hold its old binds) and after. fd 9 (the lock) is closed for tmxr,
# which could otherwise keep it, and each call gets tmxr_timeout seconds, so a
# server that hangs can't hold the lock either.
tmxr_timeout=5
tmxr_config=$HOME/.config/tmxr/config.toml

tmxr_keys() {
    local table list=()
    for table in prefix root copy-mode copy-mode-vi; do
        list+=(display-message -p "table $table" \; list-keys -N -T "$table" \;)
    done
    tmxr -L menu-keys kill-server 2>/dev/null
    {
        timeout "$tmxr_timeout" tmxr -L menu-keys -f /dev/null start-server
        [[ -f $tmxr_config ]] && timeout "$tmxr_timeout" tmxr -L menu-keys source-file "$tmxr_config"
        timeout "$tmxr_timeout" tmxr -L menu-keys show-options -gw mode-keys \; "${list[@]}" kill-server
    } 2>&1 9>&-
}

tmxr_binds() {
    # Rows come as "key  note", "prefix key  note" in the prefix table and
    # "[table] key  note" in the copy-mode ones; key names hold no spaces.
    # Anything printed before the first table line (a config error) becomes a
    # row, and a listing with no mode-keys line means the server failed.
    tmxr_keys | awk -v OFS='\t' '
        function readable(key,    mods) {
            mods = ""
            while (key ~ /^[CMS]-./) {
                mods = mods (substr(key, 1, 1) == "C" ? "CTRL" : substr(key, 1, 1) == "M" ? "ALT" : "SHIFT") " + "
                key = substr(key, 3)
            }
            return mods key
        }
        # Takes the first word off the row being read (note) and returns it.
        function next_word(    word) {
            word = note
            sub(/ .*/, "", word)
            sub(/^[^ ]+ +/, "", note)
            return word
        }
        /^mode-keys (vi|emacs)$/ { copy_table = ($0 == "mode-keys vi") ? "copy-mode-vi" : "copy-mode"; next }
        /^table [a-z-]+$/ { table = $2; next }
        table == "" { if ($0 != "") print "tmxr", "-", $0; next }
        table ~ /^copy-mode/ && table != copy_table { next }
        {
            note = $0
            if ($1 == "[" table "]") next_word()
            combo = table == "prefix" ? readable(next_word()) ", " : ""
            combo = combo readable(next_word())
            print (table == copy_table ? "tmxr copy-mode" : "tmxr"), combo, note
        }
        END { if (copy_table == "") print "tmxr", "-", "Could not read binds from tmxr" }
    '
}

binds=$({ hypr_binds; tmxr_binds; } | column -t -s $'\t' -o '    ') || {
    notify-send -u critical "Keybinding cheatsheet" "Could not build the list"
    exit 1
}

pikr -d -p Keys -l 20 --width 1000 <<<"$binds" >/dev/null 9>&-

#!/usr/bin/env bash
# vi: ft=bash

pkill -9 nmcli

# Serialise runs. The lock is held while the list is built (or a scan is in
# progress) so a second click during that window bails instead of starting a
# second menu or dismissing the scanning modal. It is released just before the
# picker launches so the toggle below can still close an open picker.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/menu-wifi.lock"
flock -n 9 || exit 0

# Toggle: a later press while the picker is open closes it. A press within
# 400 ms of it opening is a double-click, not a toggle — ignore it.
stamp="${XDG_RUNTIME_DIR:-/tmp}/menu-wifi.opened"
if pgrep -x pikr >/dev/null; then
    opened=$(cat "$stamp" 2>/dev/null || echo 0)
    (( $(date +%s%3N) - opened < 400 )) && exit 0
    pkill -9 pikr
    exit 0
fi

lock=

# nmcli's --rescan is an option of `dev wifi list` and must follow it.
#
# Reading NetworkManager's cache is instant, but once associated NM scans
# rarely and lets other access points expire — the cache can hold just the
# network you're on. So trust it only if the last scan is recent (nmcli's
# own --rescan auto uses the same 30 s cutoff). Otherwise show a modal and
# wait for a real scan: ~2.5 s on junji-pc, ~7.7 s on the T14's QCNFA765.
read_scan() {
    nmcli -g ssid,signal,bars,security dev wifi list --rescan no
}
wifi_dev=$(nmcli -g DEVICE,TYPE dev | awk -F: '$2 == "wifi" { print $1; exit }')
dbus_path=$(nmcli -g GENERAL.DBUS-PATH device show "$wifi_dev" 2>/dev/null)
last_scan() {
    busctl get-property org.freedesktop.NetworkManager "$dbus_path" \
        org.freedesktop.NetworkManager.Device.Wireless LastScan 2>/dev/null | awk '{ print $2 }'
}

before=$(last_scan)
now=$(awk '{ printf "%d", $1 * 1000 }' /proc/uptime)
fresh=false
[[ ${before:--1} -ge 0 ]] && ((now - before <= 30000)) && fresh=true

# Always request a rescan so the next open is current. NM refuses scans in
# quick succession; only wait on one it actually accepted.
rescan_ok=false
nmcli device wifi rescan >/dev/null 2>&1 && rescan_ok=true

wait_for_scan() {
    for _ in $(seq 1 60); do
        sleep 0.2
        [[ $(last_scan) != "$before" ]] && break
    done
}

# Rows for the picker, strongest first, from $scan.
build_list() {
    local ssids ssid_active ssid row signal bars security icon mark
    ssids=$(cut -d : -f1 <<<"$scan" | sort | uniq)
    ssid_active=$(nmcli -g active,ssid dev wifi list --rescan no | grep '^yes' | cut -d: -f2)
    while IFS= read -r ssid; do
        if [[ $ssid == "SSID" || $ssid == "--" || $ssid == "" ]]; then
            continue
        fi
        row=$(grep -w -F "$ssid" <<<"$scan" | head -n 1)
        signal=$(cut -d : -f2 <<<"$row")
        bars=$(cut -d : -f3 <<<"$row" | sed 's/*/█/g')
        security=$(cut -d : -f4 <<<"$row" | sed 's/WPA[1]//g' | xargs)
        icon=""
        if [[ $security != "" ]]; then
            icon=$lock
        fi
        mark="  "
        # U+F00C, Nerd Font check: ✓ (U+2713) isn't in Hack Nerd Font Mono.
        [[ $ssid == "$ssid_active" ]] && mark=$' '
        echo "$signal:$mark\"$ssid\":$bars ($signal%):$icon"
    done <<<"$ssids" | sort -k1 -nr | cut -d : -f2- | column -t -s :
}

pikr_help=$(pikr --help 2>/dev/null)

# Right on a highlighted network opens a "Forget?" card; Enter forgets it
# (pikr exits 10). Needs a pikr with --kb-custom KEY=PROMPT; stock pikr lacks
# it, so detect instead of assuming.
forget_key=()
prompt="Wi-Fi"
if grep -qF 'KEY[=PROMPT]' <<<"$pikr_help"; then
    forget_key=(--kb-custom 'Right=Forget?')
    prompt="Wi-Fi  (→ forget)"
fi

scan=$(read_scan)
loading=()
if $rescan_ok && { ! $fresh || [[ -z "${scan//[[:space:]]/}" ]]; }; then
    if grep -qF -- '--loading' <<<"$pikr_help"; then
        # Open the picker now with "Scanning…" where the list goes; the rows
        # replace it when the scan lands and build_list closes pikr's stdin.
        loading=(--loading "Scanning…")
    else
        pikr -e "Wi-Fi: scanning…" &
        modal=$!
        wait_for_scan
        kill "$modal" 2>/dev/null
        scan=$(read_scan)
    fi
fi

# Record when the picker opens (for the double-click guard above), then
# release the lock so a later press can toggle it closed.
date +%s%3N > "$stamp"
flock -u 9
if ((${#loading[@]})); then
    wifi=$( { wait_for_scan; scan=$(read_scan); build_list; } | pikr -d -p "$prompt" "${loading[@]}" "${forget_key[@]}")
else
    wifi=$(build_list | pikr -d -p "$prompt" "${forget_key[@]}")
fi
picked=$?
ssid=$(echo "$wifi" | cut -d '"' -f2)
# With --loading the rows were built from a scan read inside the producer's
# subshell; re-read it here for the security lookup and the active network.
scan=$(read_scan)
ssid_active=$(nmcli -g active,ssid dev wifi list --rescan no | grep '^yes' | cut -d: -f2)

# Cancelled (Esc exits 1) or nothing chosen. Without this, an empty SSID falls
# through: the security lookup `grep -F ""` matches the first row and a
# password prompt opens for no network.
if [[ -z $ssid || ($picked != 0 && $picked != 10) ]]; then
    exit
fi

notify() {
    command -v notify-send >/dev/null && notify-send "Wi-Fi" "$1"
}

if [[ $picked == 10 && -n $ssid ]]; then
    # pikr's card already asked "Forget?", so act immediately.
    profile=$(nmcli -g NAME,TYPE connection show | awk -F: -v s="$ssid" '$1 == s && $2 == "802-11-wireless" { print $1; exit }')
    if [[ -z $profile ]]; then
        notify "$ssid isn't a saved network"
    elif out=$(nmcli connection delete "$profile" 2>&1); then
        notify "Forgot $ssid"
    else
        notify "Could not forget $ssid: ${out#Error: }"
    fi
    exit
fi

# Already on it: nothing to do. (Forgetting it is Right on its row.)
if [[ $ssid == "$ssid_active" ]]; then
    exit
fi

# Security comes from the scan table, not the displayed row: the lock icon
# column is empty, so parsing it made every network look open and secured
# ones failed silently with "Secrets were required".
security=$(grep -w -F "$ssid" <<<"$scan" | head -n 1 | cut -d : -f4 | xargs)

# Exact-name match on wifi profiles (names may contain spaces).
connection=$(nmcli -g NAME,TYPE connection show | awk -F: -v s="$ssid" '$1 == s && $2 == "802-11-wireless" { print $1; exit }')
if [[ -n "$connection" ]]; then
    if out=$(nmcli connection up "$connection" 2>&1); then
        notify "Connected to $ssid"
        exit
    fi
    # A profile with no stored secret can't activate. The old open-network
    # path used to leave these behind; drop it and fall through to the
    # password prompt instead of failing every time.
    if grep -qi 'secrets' <<<"$out"; then
        nmcli connection delete "$connection" >/dev/null 2>&1
    else
        notify "Could not connect to $ssid: ${out#Error: }"
        exit
    fi
fi

if [[ $security == "" ]]; then
    if out=$(nmcli device wifi connect "$ssid" 2>&1); then
        notify "Connected to $ssid"
    else
        notify "Could not connect to $ssid: ${out#Error: }"
    fi
    exit
fi

password=$(echo "" | pikr -d -P -p "Password for $ssid" | xargs)
if [[ -z $password ]]; then
    exit
fi

nmcli connection add type wifi con-name "$ssid" ssid "$ssid" wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$password" >/dev/null 2>&1
if out=$(nmcli connection up "$ssid" 2>&1); then
    notify "Connected to $ssid"
else
    # A rejected password surfaces as missing secrets: drop the profile so the
    # next attempt asks again instead of reusing a wrong password. Any other
    # failure (DHCP timeout, AP out of range) keeps it — the password was
    # accepted, and deleting would make you retype a correct one.
    if grep -qi 'secrets' <<<"$out"; then
        nmcli connection delete "$ssid" >/dev/null 2>&1
    fi
    notify "Could not connect to $ssid: ${out#Error: }"
fi

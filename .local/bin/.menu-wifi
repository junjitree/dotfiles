#!/usr/bin/env bash
# vi: ft=bash

pkill -9 nmcli

pikr_kill() {
    pkill -9 pikr
}

# Toggle: a second launch while the picker is open closes it.
pikr_kill && exit 0

# Serialise the rest. Before the picker exists there is nothing for the
# toggle above to kill, so a second click during the list build used to fall
# through and start a second menu. The lock is held until this run exits
# (the fd closes), and the toggle path above never needs it.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/menu-wifi.lock"
flock -n 9 || exit 0

lock=

# One scan-list query. The per-SSID lookups below read from this table
# instead of re-running nmcli three times per network, which was ~300 ms of
# dead time before the picker could appear.
scan=$(nmcli -g ssid,signal,bars,security device wifi list)
ssids=$(cut -d : -f1 <<<"$scan" | sort | uniq)
ssid_active=$(nmcli -g active,ssid dev wifi | grep '^yes' | cut -d: -f2)

list=$(
    while IFS= read -r ssid; do
        if [[ $ssid == "SSID" || $ssid == "--" || $ssid == "" ]]; then
            continue
        fi
        row=$(grep -w -F "$ssid" <<<"$scan" | head -n 1)
        signal=$(cut -d : -f2 <<<"$row")
        bars=$(cut -d : -f3 <<<"$row" | sed 's/*/█/g')
        security=$(cut -d : -f4 <<<"$row" | sed 's/WPA[1]//g' | xargs)
        icon=""
        if [[ $security != "" ]]; then
            icon=$lock
        fi
        echo "$signal:\"$ssid\":$bars ($signal%):$icon"
    done <<<"$ssids"
)

list=$(echo "$list" | sort -k1 -nr | cut -d : -f2- | column -t -s :)
wifi=$(echo "$list" | pikr -d -p Wi-Fi)
ssid=$(echo "$wifi" | cut -d '"' -f2)
security=$(echo "$wifi" | cut -d '"' -f3 | awk '{print $3}')

if [[ $ssid == "" || $ssid == "$ssid_active" ]]; then
    exit
fi

connection=$(nmcli connection show | grep "wifi" | grep -w -F "$ssid" | awk '{print $1}' | head -n 1)
if [[ -n "$connection" ]]; then
    nmcli connection up "$ssid"
    exit
fi

if [[ $security == "" ]]; then
    nmcli device wifi connect "$ssid"
    exit
fi

password=$(echo "" | pikr -d -p Password | xargs)
if [[ -z $password ]]; then
    exit
fi

nmcli connection add type wifi con-name "$ssid" ssid "$ssid" wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$password"
nmcli connection up "$ssid"

#!/usr/bin/env bash
# vi: ft=bash

pkill -9 nmcli

# Serialise runs. The lock is held while the list is built (or a scan is in
# progress) so a second click during that window bails instead of starting a
# second menu or dismissing the scanning modal. It is released just before the
# picker launches so the toggle below can still close an open picker.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/menu-wifi.lock"
flock -n 9 || exit 0

# Toggle: a later press while the picker is open closes it. A press within
# 400 ms of it opening is a double-click, not a toggle — ignore it.
stamp="${XDG_RUNTIME_DIR:-/tmp}/menu-wifi.opened"
if pgrep -x pikr >/dev/null; then
    opened=$(cat "$stamp" 2>/dev/null || echo 0)
    (( $(date +%s%3N) - opened < 400 )) && exit 0
    pkill -9 pikr
    exit 0
fi

lock=

# nmcli's --rescan is an option of `dev wifi list` and must follow it. With the
# default (auto) nmcli blocks on a full hardware scan whenever the cache is
# stale — ~7.7 s on the T14's QCNFA765. NetworkManager keeps the cache warm
# with its own background scans, so reading it is instant and populated in
# practice. The async rescan keeps the next open fresh.
nmcli device wifi rescan >/dev/null 2>&1
scan=$(nmcli -g ssid,signal,bars,security dev wifi list --rescan no)

# Empty cache (first open after boot, wifi just enabled): show a modal so the
# wait is visible, and poll until the scan requested above lands.
if [[ -z "${scan//[[:space:]]/}" ]]; then
    pikr -e "Wi-Fi: scanning…" &
    modal=$!
    for _ in $(seq 1 40); do
        sleep 0.25
        scan=$(nmcli -g ssid,signal,bars,security dev wifi list --rescan no)
        [[ -n "${scan//[[:space:]]/}" ]] && break
    done
    kill "$modal" 2>/dev/null
fi

ssids=$(cut -d : -f1 <<<"$scan" | sort | uniq)
ssid_active=$(nmcli -g active,ssid dev wifi list --rescan no | grep '^yes' | cut -d: -f2)

list=$(
    while IFS= read -r ssid; do
        if [[ $ssid == "SSID" || $ssid == "--" || $ssid == "" ]]; then
            continue
        fi
        row=$(grep -w -F "$ssid" <<<"$scan" | head -n 1)
        signal=$(cut -d : -f2 <<<"$row")
        bars=$(cut -d : -f3 <<<"$row" | sed 's/*/█/g')
        security=$(cut -d : -f4 <<<"$row" | sed 's/WPA[1]//g' | xargs)
        icon=""
        if [[ $security != "" ]]; then
            icon=$lock
        fi
        echo "$signal:\"$ssid\":$bars ($signal%):$icon"
    done <<<"$ssids"
)

list=$(echo "$list" | sort -k1 -nr | cut -d : -f2- | column -t -s :)

# Record when the picker opens (for the double-click guard above), then
# release the lock so a later press can toggle it closed.
date +%s%3N > "$stamp"
flock -u 9
wifi=$(echo "$list" | pikr -d -p Wi-Fi)
ssid=$(echo "$wifi" | cut -d '"' -f2)

if [[ $ssid == "" || $ssid == "$ssid_active" ]]; then
    exit
fi

# Security comes from the scan table, not the displayed row: the lock icon
# column is empty, so parsing it made every network look open and secured
# ones failed silently with "Secrets were required".
security=$(grep -w -F "$ssid" <<<"$scan" | head -n 1 | cut -d : -f4 | xargs)

notify() {
    command -v notify-send >/dev/null && notify-send "Wi-Fi" "$1"
}

# Exact-name match on wifi profiles (names may contain spaces).
connection=$(nmcli -g NAME,TYPE connection show | awk -F: -v s="$ssid" '$1 == s && $2 == "802-11-wireless" { print $1; exit }')
if [[ -n "$connection" ]]; then
    if out=$(nmcli connection up "$connection" 2>&1); then
        notify "Connected to $ssid"
    else
        notify "Could not connect to $ssid: ${out#Error: }"
    fi
    exit
fi

if [[ $security == "" ]]; then
    if out=$(nmcli device wifi connect "$ssid" 2>&1); then
        notify "Connected to $ssid"
    else
        notify "Could not connect to $ssid: ${out#Error: }"
    fi
    exit
fi

password=$(echo "" | pikr -d -P -p "Password for $ssid" | xargs)
if [[ -z $password ]]; then
    exit
fi

nmcli connection add type wifi con-name "$ssid" ssid "$ssid" wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$password" >/dev/null 2>&1
if out=$(nmcli connection up "$ssid" 2>&1); then
    notify "Connected to $ssid"
else
    # Drop the failed profile so the next attempt asks for the password again
    # instead of silently reusing a wrong one.
    nmcli connection delete "$ssid" >/dev/null 2>&1
    notify "Could not connect to $ssid: ${out#Error: }"
fi

#!/usr/bin/env python3
# vi: ft=python
"""Switch kanata to a layer over its TCP server (see kanata.service.d/tcp.conf),
starting kanata first if it is off. Usage: .kanata-layer base|game"""

import json
import socket
import subprocess
import sys
import time

ADDR = ("127.0.0.1", 5829)
CONNECT_WAIT_S = 10  # kanata sleeps before grabbing devices on start
LAYERS = {
    "base": ("low", "Kanata: ON (Layer Mode)"),
    "game": ("normal", "Kanata: GAME (held Ctrl/Alt repeat)"),
}


def connect():
    deadline = time.monotonic() + CONNECT_WAIT_S
    while True:
        try:
            return socket.create_connection(ADDR, timeout=2)
        except OSError:
            if time.monotonic() > deadline:
                raise
            time.sleep(0.25)


def notify(urgency, body):
    subprocess.run(["notify-send", "-u", urgency, "-t", "2000", "Keyboard", body])


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in LAYERS:
        sys.exit(f"usage: {sys.argv[0]} {'|'.join(LAYERS)}")
    layer = sys.argv[1]
    if subprocess.run(["systemctl", "is-active", "--quiet", "kanata.service"]).returncode:
        subprocess.run(["sudo", "systemctl", "start", "kanata.service"], check=True)
    try:
        with connect() as sock:
            sock.sendall(json.dumps({"ChangeLayer": {"new": layer}}).encode() + b"\n")
    except OSError as e:
        notify("critical", f"Kanata {layer}: failed ({e})")
        sys.exit(1)
    notify(*LAYERS[layer])


main()

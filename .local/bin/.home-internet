#!/usr/bin/env python3
# vi: ft=python
"""Waybar module: shows when the house's internet is on the LTE backup.

Subscribes to Home Assistant's sensor.home_internet over its websocket API,
so HA pushes each change (no polling), and prints one Waybar JSON line per
change: the LTE pill while the sensor is LTE, empty text (which hides the
module) otherwise, including while HA can't be reached. Reconnects with a
backoff. Waybar only starts it where the HA token and python-websockets
exist (see "custom/lte" in the waybar config), so other machines on these
dotfiles never run it."""

import datetime
import json
import os
import sys
import time

from websockets.exceptions import WebSocketException
from websockets.sync.client import connect

HA_WS = "ws://192.168.0.28/api/websocket"
TOKEN_FILE = os.path.expanduser("~/.config/homeassistant/token")
ENTITY = "sensor.home_internet"
RETRY_MIN_S = 5
RETRY_MAX_S = 60
ICON = "\U000f08be"  # nf-md-signal_cellular_3


def emit(state, since):
    if state == "LTE":
        line = {
            "text": f"{ICON} LTE",
            "class": "lte",
            "tooltip": f"Home internet is on the LTE backup since {since:%H:%M} (Converge is down)",
        }
    else:
        line = {"text": ""}
    print(json.dumps(line, ensure_ascii=False), flush=True)


def watch(token):
    """Stream the sensor's state until the connection drops."""
    with connect(HA_WS) as ws:
        ws.recv()  # auth_required
        ws.send(json.dumps({"type": "auth", "access_token": token}))
        reply = json.loads(ws.recv())
        if reply["type"] != "auth_ok":
            raise PermissionError(reply.get("message", reply["type"]))
        ws.send(json.dumps({"id": 1, "type": "subscribe_entities", "entity_ids": [ENTITY]}))
        for raw in ws:
            msg = json.loads(raw)
            if msg["type"] == "result" and not msg["success"]:
                raise RuntimeError(msg["error"])
            if msg["type"] != "event":
                continue
            # subscribe_entities: "a" carries the full state on subscribe,
            # "c" a diff whose "+" has "s" and "lc" when the state changed.
            event = msg["event"]
            state = event.get("a", {}).get(ENTITY) or event.get("c", {}).get(ENTITY, {}).get("+", {})
            if "s" in state:
                emit(state["s"], datetime.datetime.fromtimestamp(state["lc"]))


def main():
    with open(TOKEN_FILE) as f:
        token = f.read().strip()
    retry = RETRY_MIN_S
    while True:
        started = time.monotonic()
        try:
            watch(token)
        except (OSError, WebSocketException, RuntimeError) as e:
            print(f"home-internet: {type(e).__name__}: {e}", file=sys.stderr, flush=True)
        emit(None, None)
        # A connection that stayed up a while was a real one: start over.
        if time.monotonic() - started > RETRY_MAX_S:
            retry = RETRY_MIN_S
        time.sleep(retry)
        retry = min(retry * 2, RETRY_MAX_S)


main()
